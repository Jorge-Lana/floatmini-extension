{
  "name": "floatmini",
  "private": true,
  "version": "1.3.4",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jorge-Lana/floatmini-extension.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-extension",
    "lint": "tsc --noEmit && node scripts/check-extension.mjs",
    "test": "node --test test/*.test.mjs",
    "check:ext": "node scripts/check-extension.mjs",
    "zip:ext": "node scripts/check-extension.mjs && node scripts/zip-extension.mjs",
    "zip:chrome": "node scripts/check-extension.mjs && node scripts/zip-extension.mjs --target=chrome",
    "zip:firefox": "node scripts/check-extension.mjs && node scripts/zip-extension.mjs --target=firefox",
    "version:set": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2"
  }
}
